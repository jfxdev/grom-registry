GROM_DEPLOYMENT_PROFILE=development
GROM_BIND_ADDRESS=127.0.0.1
GROM_HTTP_PORT=8080
GROM_PUBLIC_URL=http://localhost:8080
GROM_BOOTSTRAP_ADMIN_EMAIL=admin@grom.local
GROM_BOOTSTRAP_ADMIN_USERNAME=admin
GROM_BOOTSTRAP_ADMIN_PASSWORD=change-this-password
GROM_SECURE_COOKIES=false
GROM_ALLOW_INSECURE_PRIVATE_HTTP=false
GROM_TRUSTED_PROXIES=
GROM_AUTH_FAILURE_LIMIT=5
GROM_AUTH_FAILURE_WINDOW=5m
GROM_AUTH_BLOCK_DURATION=15m
GROM_REGISTRY_TOKEN_TTL=5m
# Optional SMTP password-reset delivery. Leave every GROM_SMTP_* value blank to
# keep reveal-once manual reset links.
GROM_SMTP_HOST=
GROM_SMTP_PORT=
GROM_SMTP_FROM_ADDRESS=
GROM_SMTP_TLS_MODE=
GROM_SMTP_USERNAME=
GROM_SMTP_PASSWORD=
GROM_REGISTRY_HTTP_SECRET=change-this-registry-http-secret
GROM_IMAGE=grom-registry:local
GROM_REGISTRY_MAINTENANCE_IMAGE=grom-registry-maintenance:local
GROM_RECOVERY_PORT=8081
GROM_VERSION=dev
