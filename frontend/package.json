{
  "name": "grom-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:api && vue-tsc -b && vite build",
    "generate:api": "openapi-typescript ../backend/api/openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "test:coverage:ci": "npm run test:coverage -- --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=coverage/frontend-junit.xml",
    "test:e2e": "playwright test",
    "test:admin-e2e": "GROM_RUN_ADMIN_E2E=1 playwright test e2e/admin-journey.spec.ts e2e/admin-destructive-flows.spec.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@lucide/vue": "^1.27.0",
    "@tanstack/vue-query": "^5.90.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^3.0.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.2.7",
    "@vue/tsconfig": "^0.8.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.10.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5"
  }
}
